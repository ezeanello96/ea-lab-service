APP_NAME=PC Service Manager
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=change-me-generate-a-real-secret
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
APP_BASE_URL=http://localhost:8000
TIME_ZONE=America/Argentina/Cordoba
LANGUAGE_CODE=es-ar
CURRENCY_CODE=ARS

POSTGRES_DB=pcservice
POSTGRES_USER=pcservice
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://pcservice:change-me@db:5432/pcservice

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

TELEGRAM_ENABLED=0
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_USER_IDS=

# Google Calendar (Fase 3)
# 1. Crear proyecto en Google Cloud Console
# 2. Habilitar Calendar API
# 3. Crear credenciales OAuth 2.0 (tipo "Aplicación web")
# 4. Agregar URI de redirección: http://localhost:8000/ordenes/google-oauth/callback/
# 5. El admin conecta su cuenta vía /ordenes/google-oauth/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/ordenes/google-oauth/callback/
GOOGLE_CALENDAR_ID=primary

MEDIA_ROOT=/app/media
BACKUP_DIR=/app/backups
MAX_UPLOAD_MB=10
LOG_LEVEL=INFO
